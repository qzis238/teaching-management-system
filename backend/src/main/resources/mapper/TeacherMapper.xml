<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mumululu.mapper.TeacherMapper">

    <select id="listTeachers" resultType="map">
        SELECT id, real_name AS realName
        FROM sys_user
        WHERE role = 2 AND is_deleted = 0
        ORDER BY id
    </select>

</mapper>
